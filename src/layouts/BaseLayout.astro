---
import '@fontsource-variable/outfit';
import '@fontsource-variable/space-grotesk';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/variants.css';
import DevVariantSwitch from '../components/DevVariantSwitch.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, site, type Locale } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { getResume } from '../lib/resume';
import { localizePath } from '../lib/urls';

interface Props {
  locale: Locale;
  /** Hub path without the locale prefix, for example `/` or `/about/`. */
  path: string;
  title?: string;
  description?: string;
  /** Adds structured data describing the owner; set on the home and About pages. */
  person?: boolean;
}

const { locale, path, title, description, person = false } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const absolute = (target: Locale) => new URL(localizePath(path, target), site.url).href;
const image = new URL(`/og.${locale}.png`, site.url).href;
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: getResume(locale).basics.label,
  url: site.url,
  sameAs: site.profiles.map((profile) => profile.url),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t('meta.description')} />
    <link rel="canonical" href={absolute(locale)} />
    {locales.map((target) => <link rel="alternate" hreflang={target} href={absolute(target)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('en')} />
    <meta name="theme-color" content="#f0f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {person && <script type="application/ld+json" set:html={JSON.stringify(personData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip.label')}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DevVariantSwitch />
  </body>
</html>

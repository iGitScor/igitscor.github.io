---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { slides } from '../../data/slides';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return slides.map((deck) => ({ params: { deck: deck.id }, props: { deck } }));
}

interface Props {
  deck: (typeof slides)[number];
}

const { deck } = Astro.props;
const t = useTranslations('en');
---

<ArchiveLayout lang="en" title={deck.title} description={deck.title} permalink={`/slides/${deck.id}.html`}>
  <section class="post">
    <header class="post-head">
      <p class="eyebrow">Slides</p>
      <h1>{deck.title}</h1>
    </header>
    <div class="deck">
      <iframe src={`${deck.url}/embed?style=light`} title={deck.title} loading="lazy" allowfullscreen></iframe>
    </div>
    <p class="post-foot">
      <a href={deck.url}>slides.com →</a>
    </p>
    <p class="post-foot">
      <a href="/">← {t('archive.back')}</a>
    </p>
  </section>
</ArchiveLayout>

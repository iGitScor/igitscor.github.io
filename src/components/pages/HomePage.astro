---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../ContactBlock.astro';
import NoteList from '../NoteList.astro';
import ProjectCard from '../ProjectCard.astro';
import ResumeList from '../ResumeList.astro';
import { now } from '../../data/now';
import type { Locale } from '../../data/site';
import { useTranslations } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';
import { caseStudyUrls } from '../../lib/case-studies';
import { getNotes } from '../../lib/notes';
import { getResume, yearOf } from '../../lib/resume';
import { localizePath } from '../../lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { basics, work } = getResume(locale);
// The first position without an end date is the current one.
const current = work.find((job) => job.endDate === null);
const projects = await getProjects();
const featured = projects.filter(({ data }) => data.featured);
const projectsUrl = localizePath('/projects/', locale);
const studies = await caseStudyUrls(locale);
const aboutUrl = localizePath('/about/', locale);
const notes = (await getNotes(locale)).slice(0, 3);
const scope = current?.name === now.scope.company ? now.scope[locale] : undefined;
const building = now.building.map((id) => {
  const project = projects.find((candidate) => candidate.id === id);
  if (!project) throw new Error(`src/data/now.ts names an unknown project "${id}"`);
  return { name: project.data.name, href: studies.get(id) ?? project.data.url ?? projectsUrl };
});
const updated = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
  new Date(now.updated),
);
---

<BaseLayout locale={locale} path="/" person>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{basics.label}</p>
      <h1>
        {t('hero.title.before')}<span class="mark">{t('hero.title.mark')}</span>{t('hero.title.after')}
      </h1>
      <p class="promise">{t('hero.promise')}</p>
      <ul class="chips" aria-label={t('hero.chips.label')}>
        <li>{t('hero.chip.quality')}</li>
        <li>{t('hero.chip.data')}</li>
        <li>{t('hero.chip.location')}</li>
      </ul>
      {
        current && (
          <p class="now">
            <span class="badge">{t('hero.now')}</span>
            {current.position}
            {current.name && ` ${t('hero.now.at')} ${current.name}`}
            {scope && `, ${scope}`} · {yearOf(current.startDate)} – {t('about.present')}
          </p>
        )
      }
      <div class="actions">
        <a class="btn btn-primary" href={projectsUrl}>{t('hero.cta.work')}</a>
        <a class="btn btn-secondary" href={aboutUrl}>{t('hero.cta.about')}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t('home.featured.eyebrow')}</p>
        <h2>{t('home.featured.title')}</h2>
      </div>
      <div class="cards">
        {featured.map((project) => <ProjectCard project={project} locale={locale} compact caseStudyUrl={studies.get(project.id)} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t('home.now.eyebrow')}</p>
        <h2>{t('home.now.title')}</h2>
      </div>
      <dl class="now-list">
        <div>
          <dt>{t('home.now.building')}</dt>
          <dd>
            {
              building.map(({ name, href }, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={href}>{name}</a>
                </>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>{t('home.now.learning')}</dt>
          <dd>{now.learning[locale]}</dd>
        </div>
      </dl>
      <p class="now-updated">
        {t('home.now.updated')} <time datetime={now.updated}>{updated}</time>
      </p>
    </div>
  </section>

  {
    notes.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">{t('home.notes.eyebrow')}</p>
            <h2>{t('home.notes.title')}</h2>
          </div>
          <NoteList locale={locale} notes={notes} />
          <p class="section-more">
            <a class="link-arrow" href={localizePath('/notes/', locale)}>{t('home.notes.all')}</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t('home.resume.eyebrow')}</p>
        <h2>{basics.name}</h2>
      </div>
      <ResumeList locale={locale} limit={3} />
      <p class="section-more">
        <a class="link-arrow" href={aboutUrl}>{t('home.resume.more')}</a>
      </p>
    </div>
  </section>

  <ContactBlock locale={locale} />
</BaseLayout>

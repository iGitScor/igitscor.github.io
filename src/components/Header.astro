---
import LangSwitch from './LangSwitch.astro';
import Mark from './Mark.astro';
import { site, type Locale } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { localizePath } from '../lib/urls';

interface Props {
  locale: Locale;
  /** Hub path of the current page. Archive pages have no twin and omit it. */
  path?: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const links = [
  { path: '/projects/', label: t('nav.projects') },
  { path: '/about/', label: t('nav.about') },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={localizePath('/', locale)} aria-label={`${site.name}, ${t('nav.home')}`}>
      <Mark />
      iScor
    </a>
    <nav class="site-nav" aria-label={t('nav.label')}>
      {
        links.map((link) => (
          <a href={localizePath(link.path, locale)} aria-current={link.path === path ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    {path && <LangSwitch locale={locale} path={path} />}
  </div>
</header>

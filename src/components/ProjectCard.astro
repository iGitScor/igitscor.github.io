---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  /** Heading level of the project name; game items sit one level below. */
  level?: 2 | 3;
}

const { project, locale, level = 3 } = Astro.props;
const { data } = project;
const t = useTranslations(locale);
const Heading = `h${level}` as 'h2' | 'h3';
const ItemHeading = `h${level + 1}` as 'h3' | 'h4';
const badge = data.period ?? (data.status === 'live' ? undefined : t(`status.${data.status}`));
---

<article class="card">
  {
    data.cover && data.coverAlt && (
      <Image class="card-cover" src={data.cover} alt={data.coverAlt[locale]} width={720} />
    )
  }
  <div class="card-body">
    <header class="card-head">
      <Heading>{data.name}</Heading>
      {badge && <span class="badge">{badge}</span>}
    </header>
    <p class="card-tagline">{data.tagline[locale]}</p>
    <p class="card-summary">{data.summary[locale]}</p>

    {
      data.items.length > 0 && (
        <ul class="card-items">
          {data.items.map((item) => (
            <li>
              <a class="item" href={item.url}>
                <Image src={item.cover} alt="" width={480} />
                <span class="item-text">
                  <ItemHeading>{item.name}</ItemHeading>
                  <span>{item.blurb[locale]}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      data.stack.length > 0 && (
        <ul class="chips">
          {data.stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
      )
    }

    <p class="card-links">
      {
        data.url && (
          <a class="link-arrow" href={data.url}>
            {t('card.visit')}
            <span class="visually-hidden"> {data.name}</span>
          </a>
        )
      }
      {
        data.repo && (
          <a class="link-arrow" href={`https://github.com/${data.repo}`}>
            {t('card.source')}
            <span class="visually-hidden"> {data.name}</span>
          </a>
        )
      }
    </p>
  </div>
</article>

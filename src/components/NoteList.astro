---
import type { Locale } from '../data/site';
import { noteUrl, type Note } from '../lib/notes';

interface Props {
  locale: Locale;
  notes: Note[];
}

const { locale, notes } = Astro.props;
const day = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' });
---

<ul class="note-list">
  {
    notes.map((note) => (
      <li>
        <time datetime={note.data.date.toISOString().slice(0, 10)}>{day.format(note.data.date)}</time>
        <div>
          <a href={noteUrl(note, locale)}>{note.data.title}</a>
          <p>{note.data.description}</p>
        </div>
      </li>
    ))
  }
</ul>

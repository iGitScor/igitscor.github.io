---
// Design checkpoint only: switches between the three looks in `astro dev`.
// It renders nothing in a build, so the published pages stay script-free.
---

{
  import.meta.env.DEV && (
    <>
      <div class="variant-switch" role="group" aria-label="Design variant">
        <span>Design</span>
        <button type="button" data-variant-choice="a">A · Myna</button>
        <button type="button" data-variant-choice="b">B · Bucket List</button>
        <button type="button" data-variant-choice="c">C · Minimal</button>
      </div>
      <style is:global>
        .variant-switch {
          position: fixed;
          left: 16px;
          bottom: 16px;
          z-index: 100;
          display: flex;
          align-items: center;
          gap: 4px;
          padding: 5px 5px 5px 14px;
          border-radius: 999px;
          background: #111;
          color: #f0f0e8;
          font: 600 12px/1 ui-sans-serif, system-ui, sans-serif;
          box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }
        .variant-switch span {
          margin-right: 6px;
          opacity: 0.7;
        }
        .variant-switch button {
          padding: 7px 12px;
          border: 0;
          border-radius: 999px;
          background: none;
          color: inherit;
          font: inherit;
          cursor: pointer;
        }
        .variant-switch button[aria-pressed='true'] {
          background: #b9ff66;
          color: #111;
        }
      </style>
      <script is:inline>
        (() => {
          const root = document.documentElement;
          const buttons = document.querySelectorAll('[data-variant-choice]');
          const apply = (variant) => {
            if (variant === 'a') delete root.dataset.variant;
            else root.dataset.variant = variant;
            for (const button of buttons) {
              button.setAttribute('aria-pressed', String(button.dataset.variantChoice === variant));
            }
          };
          const fromUrl = new URLSearchParams(location.search).get('variant');
          let stored = null;
          try {
            if (fromUrl) localStorage.setItem('variant', fromUrl);
            stored = localStorage.getItem('variant');
          } catch {}
          apply(fromUrl ?? stored ?? 'a');
          for (const button of buttons) {
            button.addEventListener('click', () => {
              try {
                localStorage.setItem('variant', button.dataset.variantChoice);
              } catch {}
              apply(button.dataset.variantChoice);
            });
          }
        })();
      </script>
    </>
  )
}

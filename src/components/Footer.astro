---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <ul>
      {
        site.profiles.map((profile) => (
          <li>
            <a href={profile.url} rel="me">
              {profile.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
